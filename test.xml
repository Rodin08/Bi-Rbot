<mujoco>
  <worldbody>
    <geom type="plane" size="10 10 0.01" pos="0 0 -0.5"></geom>

    <body name="Body">
      <geom type="box" size="0.1 0.1 0.075" rgba="0 1 0.6 1" mass="1.5"></geom>
      <freejoint></freejoint>
      <site name="imu" pos="0 0 0"></site>

      <body name="RightThigh" pos="0.12 -0.025 -0.1">
        <geom type="box" size="0.02 0.04 0.1" rgba="1 0 .5 1" mass="0.2"></geom>
        <joint name="hip_R" type="hinge" pos="0 0 0.1" axis="1 0 0" range="-90 90"></joint>

        <body name="RightShin" pos="0 0 -0.2">
          <geom type="box" size="0.02 0.04 0.1" rgba="0 .8 1 1" mass="0.15"></geom>
          <joint name="knee_R" type="hinge" pos="0 0 0.1" axis="1 0 0" range="-140 140"></joint>

          <body name="RightWheel" pos="0.03 0 -0.1">
            <geom type="cylinder" size="0.07 0.01" rgba="1 0.7 0 1" euler="0 90 0" mass="0.25"></geom>
            <joint name="wheel_R" type="hinge" axis="1 0 0"></joint>
          </body>
        </body>
      </body>

      <body name="LeftThigh" pos="-0.12 -0.025 -0.1">
        <geom type="box" size="0.02 0.04 0.1" rgba="1 0 .5 1" mass="0.2"></geom>
        <joint name="hip_L" type="hinge" pos="0 0 0.1" axis="1 0 0" range="-90 90"></joint>

        <body name="LeftShin" pos="0 0 -0.2">
          <geom type="box" size="0.02 0.04 0.1" rgba="0 .8 1 1" mass="0.15"></geom>
          <joint name="knee_L" type="hinge" pos="0 0 0.1" axis="1 0 0" range="-140 140"></joint>

          <body name="LeftWheel" pos="-0.03 0 -0.1">
            <geom type="cylinder" size="0.07 0.01" rgba="1 0.7 0 1" euler="0 90 0" mass="0.25"></geom>
            <joint name="wheel_L" type="hinge" axis="1 0 0"></joint>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <accelerometer name="accel" site="imu"></accelerometer>
    <gyro name="gyro" site="imu"></gyro>
  </sensor>

  <actuator>
    <position name="hip_R" joint="hip_R" kp="20" kv="0.5" ctrlrange="-1.57 1.57" forcerange="-3 3" />
    <position name="hip_L" joint="hip_L" kp="20" kv="0.5" ctrlrange="-1.57 1.57" forcerange="-3 3" />
    <position name="knee_R" joint="knee_R" kp="20" kv="0.5" ctrlrange="-2.44 2.44" forcerange="-3 3" />
    <position name="knee_L" joint="knee_L" kp="20" kv="0.5" ctrlrange="-2.44 2.44" forcerange="-3 3" />
    <motor name="wheel_R" joint="wheel_R" ctrlrange="-1 1" />
    <motor name="wheel_L" joint="wheel_L" ctrlrange="-1 1" />
  </actuator>
</mujoco>
